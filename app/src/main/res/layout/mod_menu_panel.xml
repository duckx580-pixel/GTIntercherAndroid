<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/launcher_card"
    android:padding="12dp"
    android:minWidth="280dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="GTIntercher Menu"
            android:textColor="@color/launcher_text_primary"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/mod_menu_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="&#10005;"
            android:textColor="@color/launcher_text_secondary"
            android:textSize="16sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="8dp"
        android:background="@color/launcher_border" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="Send chat message or command"
        android:textColor="@color/launcher_text_secondary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/mod_menu_command"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/launcher_bg"
            android:hint="/help"
            android:imeOptions="actionSend"
            android:inputType="text"
            android:maxLines="1"
            android:padding="8dp"
            android:textColor="@color/launcher_text_primary"
            android:textColorHint="@color/launcher_text_dim" />

        <Button
            android:id="@+id/mod_menu_send"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:backgroundTint="@color/launcher_purple"
            android:text="Send"
            android:textColor="@color/launcher_text_primary" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="Quick commands"
        android:textColor="@color/launcher_text_secondary"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/mod_menu_quick_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal" />

    <TextView
        android:id="@+id/mod_menu_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/launcher_text_dim"
        android:textSize="11sp" />
</LinearLayout>
